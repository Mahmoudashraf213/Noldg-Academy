# Copy to config/.env locally. Set these in Vercel Project Settings for deployments.
NEON_DATABASE_URL=
NEON_DIRECT_URL=
SECRET_KEY=
PASSWORD_RESET_SECRET=
CRON_SECRET=
CLIENT_ORIGIN=http://localhost:5173
CLOUD_NAME=
API_KEY=
API_SECRET=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RESET_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_DEFAULT_COUNTRY_CODE=20
# Prevent Puppeteer's unused browser download during installation.
PUPPETEER_SKIP_DOWNLOAD=true
