{
  "info": {
    "name": "Noldg Academy - Notifications",
    "description": "Set role emails/passwords and an available productId in collection variables. Run login requests first. Purchase approval and rejection are alternative final decisions: run only one per order. The SSE request stays open; run it manually in a separate tab. Existing user device/session restrictions still apply. Apply the notifications migration before these requests. This collection does not create users or products.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "studentEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "superAdminEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "superAdminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "superAdminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 - Login roles",
      "item": [
        {
          "name": "Login student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('studentToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{teacherPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('teacherToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login superAdmin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('superAdminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Purchase flow",
      "item": [
        {
          "name": "Student - Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "token",
                "value": "{{studentToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('orderId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Student - Submit payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "token",
                "value": "{{studentToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"notes\": \"Postman notification verification\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inbox admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/notifications?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Inbox response', () => { const body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('array'); pm.expect(body.unreadCount).to.be.a('number'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Choose ONE final decision",
      "item": [
        {
          "name": "Admin - APPROVE purchase",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "token",
                "value": "{{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/order-approval/{{orderId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin - REJECT purchase (alternative)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "token",
                "value": "{{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/order-approval/{{orderId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"reason\": \"Payment not received - Postman test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 - Inboxes and read actions",
      "item": [
        {
          "name": "Inbox student",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{studentToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/notifications?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Inbox response', () => { const body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('array'); pm.expect(body.unreadCount).to.be.a('number'); });",
                  "const first = pm.response.json().data?.[0]; if (first) pm.collectionVariables.set('notificationId', first._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Inbox teacher",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{teacherToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/notifications?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Inbox response', () => { const body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('array'); pm.expect(body.unreadCount).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Inbox admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/notifications?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Inbox response', () => { const body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('array'); pm.expect(body.unreadCount).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Inbox superAdmin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{superAdminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/notifications?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Inbox response', () => { const body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('array'); pm.expect(body.unreadCount).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Student - Unread only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{studentToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/notifications?unread=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student - Filter submitted payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{studentToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/notifications?type=payment_submitted"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student - Mark one read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "token",
                "value": "{{studentToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Student - Mark all read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "token",
                "value": "{{studentToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/notifications/read-all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Without token - Must reject",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/notifications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 - SSE (run manually, stays open)",
      "item": [
        {
          "name": "Student - Live inbox stream",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{studentToken}}"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": "{{baseUrl}}/api/notifications/stream",
            "description": "Open this request separately. A notifications event contains a complete first-page snapshot. Trigger a purchase or read action in another tab; updates arrive within about 3 seconds. Cancel this request to close the stream."
          }
        }
      ]
    }
  ]
}
